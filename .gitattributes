# Normalise line endings so the repo behaves the same on Windows, Linux, macOS
* text=auto

# Shell scripts MUST be LF — CRLF breaks the shebang line and bash
*.sh text eol=lf

# Markdown / config / docs — LF
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.conf  text eol=lf

# Docker / CI files — LF (CRLF here causes real container failures)
Dockerfile*  text eol=lf
*.dockerfile text eol=lf

# Binary files — never touch these
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.zip  binary
*.gz   binary
